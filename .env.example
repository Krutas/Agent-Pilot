# ============================================================
# Agent Pilot - example configuration
# ============================================================
# Copy this file to .env, uncomment ONLY the settings you use,
# and replace example values with your real endpoints / keys.
# Never commit .env to Git.
# ============================================================

# AGENT_PILOT_HOME=/opt/agent-pilot
# AGENT_PILOT_ROLE=worker
# AGENT_PILOT_NODE_NAME=worker-01
# AGENT_PILOT_DRY_RUN=false

# --- Tailscale ------------------------------------------------
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx
# TAILSCALE_HOSTNAME=agent-worker-01
# TAILSCALE_TAGS=tag:agent,tag:worker
# TAILSCALE_EXTRA_ARGS=

# --- Headscale ------------------------------------------------
# HEADSCALE_URL=https://headscale.example.internal
# HEADSCALE_PREAUTH_KEY=xxxxxxxxxxxxxxxx
# HEADSCALE_LISTEN_ADDR=0.0.0.0:8080
# HEADSCALE_SERVER_URL=https://headscale.example.internal
# HEADSCALE_DNS_BASE_DOMAIN=agents.internal

# --- AgentGateway ---------------------------------------------
# AGENTGATEWAY_IMAGE=cr.agentgateway.dev/agentgateway:v1.5.0
# AGENTGATEWAY_PORT=4000
# AGENTGATEWAY_CONFIG_DIR=/opt/agent-pilot/agentgateway-config
# AGENTGATEWAY_URL=http://100.64.0.10:4000
# AGENTGATEWAY_API_KEY=replace-me

# --- MCP -------------------------------------------------------
# MCP_GATEWAY_URL=http://100.64.0.10:4000/mcp
# MCP_BEARER_TOKEN=replace-me
# MCP_SERVER_1_NAME=filesystem-agent
# MCP_SERVER_1_URL=http://100.64.0.21:3000/mcp
# MCP_SERVER_1_TOKEN=replace-me

# --- A2A -------------------------------------------------------
# A2A_GATEWAY_URL=http://100.64.0.10:4000/a2a
# A2A_BEARER_TOKEN=replace-me
# A2A_AGENT_1_NAME=research-agent
# A2A_AGENT_1_URL=http://100.64.0.22:8080/a2a
# A2A_AGENT_1_TOKEN=replace-me

# --- Generic remote agents -----------------------------------
# REMOTE_AGENT_1_NAME=worker-b
# REMOTE_AGENT_1_PROTOCOL=mcp
# REMOTE_AGENT_1_ENDPOINT=http://100.64.0.23:4000/mcp
# REMOTE_AGENT_1_API_KEY=replace-me

# REMOTE_AGENT_2_NAME=worker-c
# REMOTE_AGENT_2_PROTOCOL=a2a
# REMOTE_AGENT_2_ENDPOINT=http://100.64.0.24:8080/a2a
# REMOTE_AGENT_2_API_KEY=replace-me

# REMOTE_AGENT_3_NAME=custom-http-agent
# REMOTE_AGENT_3_PROTOCOL=http
# REMOTE_AGENT_3_ENDPOINT=http://100.64.0.25:9000
# REMOTE_AGENT_3_API_KEY=replace-me

# --- Callback / webhook ---------------------------------------
# AGENT_CALLBACK_URL=http://100.64.0.10:4000/callback
# AGENT_CALLBACK_TOKEN=replace-me

# --- Optional state store -------------------------------------
# DATABASE_URL=postgresql://agentpilot:password@100.64.0.30:5432/agentpilot

# --- Agent app path overrides ---------------------------------
# OPENCODE_INSTALL_DIR=
# HERMES_HOME=
# CODEX_HOME=

# Agent Pilot does NOT configure model providers.
# Model/provider/API configuration belongs inside the agent app
# chosen by the user after installation.
